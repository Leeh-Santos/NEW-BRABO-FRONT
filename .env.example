# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Required for WalletConnect/QR wallet connections in RainbowKit.
# Get a free projectId at https://cloud.reown.com
VITE_WALLETCONNECT_PROJECT_ID=

# Optional — defaults to the public Base RPC (https://mainnet.base.org) if unset.
VITE_BASE_RPC_URL=
